                <mxCell id="rel_9" edge="1" parent="1" source="card_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=0;strokeWidth=1.4;strokeColor=#64748b;dashed=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="import_card_id" value="same owner / card">
